DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Generate your own with `openssl rand -hex 32`.
JWT_SECRET="replace-with-a-long-random-string"

# Anthropic (Claude) API key — required for JARVIS to think, understand documents and images.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Tavily API key (optional) — enables real-time web search. Get one at https://tavily.com/
# Without it, the Research module reports that web search is not configured instead of
# fabricating results.
TAVILY_API_KEY=""
