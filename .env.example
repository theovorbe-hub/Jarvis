# --- Database ---
# SQLite by default (zero config). For production, point this at Postgres
# and change the provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# --- AI ---
# Required for JARVIS to actually think. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Model used by the AI layer (see src/lib/ai/anthropic.ts to change).
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Auth ---
# Random secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"

# --- Uploads ---
# Local folder where uploaded documents/images are stored.
UPLOADS_DIR="./uploads"
