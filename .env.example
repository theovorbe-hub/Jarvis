# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Auth ---
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- AI Provider ---
# Abstraction layer defaults to Anthropic. Swap AI_PROVIDER + keys to change model without
# touching application code (see src/lib/ai/provider.ts).
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-5"

# --- Web Search (optional) ---
# If set, Tavily is used for higher-quality web search results.
# If omitted, JARVIS falls back to a keyless DuckDuckGo HTML search.
TAVILY_API_KEY=""

# --- Weather (optional) ---
# Open-Meteo requires no API key; set a default location for the dashboard.
DEFAULT_LAT="48.8566"
DEFAULT_LON="2.3522"
DEFAULT_CITY="Paris"
