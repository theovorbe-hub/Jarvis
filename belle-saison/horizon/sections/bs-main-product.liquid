      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "icon_1",
          "label": "Icône 1",
          "options": [
            {
              "value": "gift",
              "label": "Cadeau"
            },
            {
              "value": "pencil",
              "label": "Crayon"
            },
            {
              "value": "truck",
              "label": "Livraison"
            },
            {
              "value": "leaf",
              "label": "Feuille"
            },
            {
              "value": "shield",
              "label": "Garantie"
            },
            {
              "value": "printer",
              "label": "Impression"
            }
          ],
          "default": "gift"
        },
        {
          "type": "text",
          "id": "text_1",
          "label": "Texte 1",
          "default": "Échantillon offert"
        },
        {
          "type": "select",
          "id": "icon_2",
          "label": "Icône 2",
          "options": [
            {
              "value": "gift",
              "label": "Cadeau"
            },
            {
              "value": "pencil",
              "label": "Crayon"
            },
            {
              "value": "truck",
              "label": "Livraison"
            },
            {
              "value": "leaf",
              "label": "Feuille"
            },
            {
              "value": "shield",
              "label": "Garantie"
            },
            {
              "value": "printer",
              "label": "Impression"
            }
          ],
          "default": "pencil"
        },
        {
          "type": "text",
