<button
  type="button"
  class="wishlist-button{% if class %} {{ class }}{% endif %}"
  data-wishlist-toggle
  data-handle="{{ product.handle }}"
  aria-pressed="false"
>
  <span class="wishlist-button__off">{% render 'bs-icon', name: 'heart' %}</span>
  <span class="wishlist-button__on">{% render 'bs-icon', name: 'heart-fill' %}</span>
  <span class="bs-visually-hidden">{{ 'bs.products.product.wishlist_add' | t: title: product.title }}</span>
</button>
