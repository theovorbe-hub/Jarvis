{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'gift_cards.title' | t }} | {{ shop.name }}</title>
    {%- render 'css-variables' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="gift-card page-width page-width--narrow">
      <p class="header__logo"><span class="header__wordmark">{{ shop.name | escape }}</span></p>
      {%- assign initial_value = gift_card.initial_value | money -%}
      {%- assign balance_value = gift_card.balance | money -%}
      <h1 class="h-1">{{ 'gift_cards.heading' | t: value: initial_value }}</h1>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="field__error">{{ 'gift_cards.unavailable' | t }}</p>
      {%- endif -%}
      <p class="gift-card__balance">{{ 'gift_cards.balance' | t: value: balance_value }}</p>
      <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
      {%- if gift_card.expires_on -%}
        {%- assign expiry = gift_card.expires_on | date: '%d/%m/%Y' -%}
        <p>{{ 'gift_cards.expires' | t: date: expiry }}</p>
      {%- endif -%}
      <div class="button-row">
        <a class="button" href="{{ shop.url }}">{{ 'gift_cards.shop' | t }}</a>
        <button type="button" class="button button--secondary" onclick="window.print();">{{ 'gift_cards.print' | t }}</button>
      </div>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}" class="link-arrow">{{ 'gift_cards.wallet' | t }}</a>
      {%- endif -%}
    </main>
  </body>
</html>
