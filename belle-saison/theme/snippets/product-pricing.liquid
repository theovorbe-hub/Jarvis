{%- comment -%}
  Calcule le mode de vente et le prix de base d'un produit (hors échantillon).
  Sortie : capture une chaîne "mode|prix_centimes|variante_echantillon_id"
  Usage :
    {%- capture pricing -%}{% render 'product-pricing', product: product %}{%- endcapture -%}
{%- endcomment -%}
{%- liquid
  assign sample_label = settings.sample_option_label | downcase | strip
  assign mode_raw = product.metafields.papier_peint.mode_vente.value | default: settings.default_sale_mode | downcase
  if mode_raw contains 'roul'
    assign mode = 'rouleau'
  else
    assign mode = 'm2'
  endif

  assign base_price = -1
  assign sample_id = ''
  for v in product.variants
    assign vt = v.title | downcase
    if sample_label != blank and vt contains sample_label
      if sample_id == ''
        assign sample_id = v.id
      endif
      continue
    endif
    if base_price == -1 or v.price < base_price
      assign base_price = v.price
    endif
  endfor
  if base_price == -1
    assign base_price = product.price_min
  endif
  echo mode | append: '|' | append: base_price | append: '|' | append: sample_id
-%}
