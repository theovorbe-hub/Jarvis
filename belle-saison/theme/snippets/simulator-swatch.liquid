{%- comment -%}
  Vignette d'un papier peint dans le simulateur « Voir sur mon mur » : un clic l'essaie sur le mur.
  Paramètres : pattern (produit avec un métachamp papier_peint.visuel), pressed (vignette choisie),
  tile_cm (facultatif : largeur réelle du motif ; sinon lue dans les métachamps du produit).
{%- endcomment -%}
{%- liquid
  assign swatch_pp = pattern.metafields.papier_peint
  assign swatch_visuel = swatch_pp.visuel.value
  if tile_cm != nil
    assign swatch_tile = tile_cm
  else
    assign swatch_tile = swatch_pp.largeur_visuel.value | default: 0
    assign swatch_mode = swatch_pp.mode_vente.value | default: settings.default_sale_mode | downcase
    if swatch_tile == 0 and swatch_mode contains 'roul'
      assign swatch_tile = swatch_pp.largeur_le.value | default: settings.default_strip_width
    endif
  endif
-%}
<button
  type="button"
  class="simulator__swatch"
  data-sim-swatch
  aria-pressed="{{ pressed | default: false }}"
  title="{{ pattern.title | escape }}"
  data-visuel="{{ swatch_visuel | image_url: width: 2048 }}"
  data-tile-cm="{{ swatch_tile }}"
  data-title="{{ pattern.title | escape }}"
  data-handle="{{ pattern.handle | escape }}"
  data-url="{{ pattern.url }}"
  data-share-url="{{ request.origin }}{{ pattern.url }}"
>
  <img src="{{ swatch_visuel | image_url: width: 160, height: 160, crop: 'center' }}" alt="" width="56" height="56" loading="lazy">
  <span class="visually-hidden">{{ pattern.title | escape }}</span>
</button>
