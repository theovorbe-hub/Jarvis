{%- paginate blog.articles by 9 -%}
  <section class="blog page-width">
    <header class="collection__header">
      <h1 class="h-display">{{ blog.title | escape }}</h1>
    </header>
    {%- if blog.articles.size > 0 -%}
      <ul class="blog__grid" role="list">
        {%- for article in blog.articles -%}
          <li class="article-card" data-reveal>
            <a href="{{ article.url }}" class="article-card__link">
              <div class="article-card__media">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', class: 'article-card__image' }}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'article-card__image placeholder-svg' }}
                {%- endif -%}
              </div>
              <p class="article-card__date">{{ article.published_at | time_tag: format: 'date' }}</p>
              <h2 class="h-3">{{ article.title | escape }}</h2>
              <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- render 'pagination', paginate: paginate -%}
    {%- else -%}
      <div class="empty-state"><p class="h-3">{{ 'blogs.empty' | t }}</p></div>
    {%- endif -%}
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Journal",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
