<article class="article page-width page-width--narrow">
  <header class="article__header">
    <p class="article-card__date">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="h-display">{{ article.title | escape }}</h1>
  </header>
  {%- if article.image -%}
    <div class="article__media">
      {{ article.image | image_url: width: 2000 | image_tag: widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 990px) 860px, 100vw', class: 'article__image' }}
    </div>
  {%- endif -%}
  <div class="rte article__content">{{ article.content }}</div>
  <a class="link-arrow link-arrow--back" href="{{ blog.url }}">
    {% render 'icon', name: 'arrow-left' %}
    {{ 'blogs.back' | t: title: blog.title }}
  </a>
</article>

{% schema %}
{
  "name": "Article",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
