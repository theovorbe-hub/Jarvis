{%- comment -%}
  Bandeau d'arguments. Sur grand écran, tous les messages tiennent sur une ligne ; en dessous
  de 1200 px (mobile, tablette), ils défilent lentement en continu pour que tous restent
  visibles (la seconde liste, masquée aux lecteurs d'écran, sert à boucler sans saut).
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="usp-bar">
    <div class="usp-bar__viewport page-width">
      {%- for pass in (1..2) -%}
        <ul class="usp-bar__list{% if pass == 2 %} usp-bar__list--copy{% endif %}" role="list"{% if pass == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <li class="usp-bar__item" {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>
              {%- if block.settings.icon != 'none' -%}
                {%- render 'icon', name: block.settings.icon -%}
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}"{% if pass == 2 %} tabindex="-1"{% endif %}>{{ block.settings.text | escape }}</a>
              {%- else -%}
                <span>{{ block.settings.text | escape }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau d'annonce",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Argument",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            {
              "value": "none",
              "label": "Aucune"
            },
            {
              "value": "gift",
              "label": "Cadeau"
            },
            {
              "value": "pencil",
              "label": "Crayon"
            },
            {
              "value": "ruler",
              "label": "Règle"
            },
            {
              "value": "printer",
              "label": "Impression"
            },
            {
              "value": "leaf",
              "label": "Feuille"
            },
            {
              "value": "truck",
              "label": "Livraison"
            },
            {
              "value": "diamond",
              "label": "Diamant"
            },
            {
              "value": "shield",
              "label": "Garantie"
            },
            {
              "value": "phone",
              "label": "Téléphone"
            }
          ],
          "default": "gift"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Échantillon offert"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "item",
        "settings": {
          "icon": "gift",
          "text": "Échantillon offert"
        }
      },
      {
        "type": "item",
        "settings": {
          "icon": "pencil",
          "text": "Adaptation sur mesure incluse"
        }
      },
      {
        "type": "item",
        "settings": {
          "icon": "leaf",
          "text": "Impression européenne haut de gamme"
        }
      },
      {
        "type": "item",
        "settings": {
          "icon": "truck",
          "text": "Livraison sous 5 à 7 jours"
        }
      }
    ]
  }
}
{% endschema %}
