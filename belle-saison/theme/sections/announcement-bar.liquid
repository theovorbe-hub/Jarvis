{%- if section.blocks.size > 0 -%}
  <div class="usp-bar">
    <ul class="usp-bar__list page-width" role="list">
      {%- for block in section.blocks -%}
        <li class="usp-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            {%- render 'icon', name: block.settings.icon -%}
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            <span>{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau d'annonce",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Argument",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            {
              "value": "none",
              "label": "Aucune"
            },
            {
              "value": "gift",
              "label": "Cadeau"
            },
            {
              "value": "pencil",
              "label": "Crayon"
            },
            {
              "value": "ruler",
              "label": "Règle"
            },
            {
              "value": "printer",
              "label": "Impression"
            },
            {
              "value": "leaf",
              "label": "Feuille"
            },
            {
              "value": "truck",
              "label": "Livraison"
            },
            {
              "value": "diamond",
              "label": "Diamant"
            },
            {
              "value": "shield",
              "label": "Garantie"
            },
            {
              "value": "phone",
              "label": "Téléphone"
            }
          ],
          "default": "gift"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Échantillon offert"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "item",
        "settings": {
          "icon": "gift",
          "text": "Échantillon offert"
        }
      },
      {
        "type": "item",
        "settings": {
          "icon": "pencil",
          "text": "Adaptation sur mesure incluse"
        }
      },
      {
        "type": "item",
        "settings": {
          "icon": "leaf",
          "text": "Impression européenne haut de gamme"
        }
      },
      {
        "type": "item",
        "settings": {
          "icon": "truck",
          "text": "Livraison sous 5 à 7 jours"
        }
      }
    ]
  }
}
{% endschema %}
