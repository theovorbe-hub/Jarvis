{%- liquid
  assign slide_count = section.blocks.size
  if section.index == 1
    assign first_loading = 'eager'
  else
    assign first_loading = 'lazy'
  endif
-%}
<section
  class="hero"
  data-slideshow
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed }}"
  aria-roledescription="{{ 'sections.hero.carousel' | t }}"
  aria-label="{{ 'sections.hero.label' | t }}"
>
  <div class="hero__track">
    {%- for block in section.blocks -%}
      {%- liquid
        if forloop.first and section.index == 1
          assign heading_tag = 'h1'
        else
          assign heading_tag = 'h2'
        endif
        if forloop.first
          assign loading = first_loading
          assign fetch_priority = 'high'
        else
          assign loading = 'lazy'
          assign fetch_priority = 'auto'
        endif
      -%}
      <div
        class="hero__slide{% if forloop.first %} is-active{% endif %}"
        data-slide
        role="group"
        aria-roledescription="{{ 'sections.hero.slide' | t }}"
        aria-label="{{ forloop.index }} / {{ slide_count }}"
        {% unless forloop.first %}
          aria-hidden="true"
        {% endunless %}
        {{ block.shopify_attributes }}
      >
        <div class="hero__media">
          {%- if block.settings.image != blank -%}
            {%- if block.settings.image_mobile != blank -%}
              <picture>
                <source
                  media="(max-width: 749px)"
                  srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w"
                  sizes="100vw"
                >
                {{
                  block.settings.image
                  | image_url: width: 2800
                  | image_tag:
                    widths: '900, 1200, 1600, 2000, 2400, 2800',
                    sizes: '100vw',
                    loading: loading,
                    fetchpriority: fetch_priority,
                    class: 'hero__image'
                }}
              </picture>
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 2800
                | image_tag:
                  widths: '750, 1100, 1500, 2000, 2400, 2800',
                  sizes: '100vw',
                  loading: loading,
                  fetchpriority: fetch_priority,
                  class: 'hero__image'
              }}
            {%- endif -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__image placeholder-svg' }}
          {%- endif -%}
          <div class="hero__scrim" style="--scrim-opacity: {{ block.settings.scrim | divided_by: 100.0 }};"></div>
        </div>

        <div class="hero__content page-width">
          <div class="hero__text">
            {%- if block.settings.eyebrow != blank -%}
              <p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}
            <{{ heading_tag }} class="h-display hero__heading">{{ block.settings.heading }}</{{ heading_tag }}>
            {%- if block.settings.text != blank -%}
              <div class="hero__subtext">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <div class="button-row">
                <a class="button" href="{{ block.settings.button_link | default: routes.collections_url }}">
                  {{- block.settings.button_label | escape -}}
                  {% render 'icon', name: 'arrow-right' %}
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  <div class="hero__footer page-width">
    {%- if section.settings.video_url != blank and section.settings.video_label != blank -%}
      {%- render 'video-trigger', video_url: section.settings.video_url, label: section.settings.video_label, id: section.id -%}
    {%- else -%}
      <span></span>
    {%- endif -%}

    {%- if slide_count > 1 -%}
      <div class="hero__controls">
        <button type="button" class="hero__arrow" data-slide-prev>
          {% render 'icon', name: 'arrow-left' %}
          <span class="visually-hidden">{{ 'sections.hero.previous' | t }}</span>
        </button>
        <ol class="hero__dots" role="list">
          {%- for block in section.blocks -%}
            <li>
              <button
                type="button"
                class="hero__dot{% if forloop.first %} is-active{% endif %}"
                data-slide-to="{{ forloop.index0 }}"
                {% if forloop.first %}
                  aria-current="true"
                {% endif %}
              >
                <span class="visually-hidden">{{ 'sections.hero.go_to' | t }}</span>
                {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
              </button>
            </li>
          {%- endfor -%}
        </ol>
        <button type="button" class="hero__arrow" data-slide-next>
          {% render 'icon', name: 'arrow-right' %}
          <span class="visually-hidden">{{ 'sections.hero.next' | t }}</span>
        </button>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ouverture",
  "class": "section-hero",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Défilement automatique",
      "info": "Désactivé si le visiteur a demandé à réduire les animations.",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Durée par image",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 7
    },
    {
      "type": "header",
      "content": "Vidéo"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Lien de la vidéo",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "text",
      "id": "video_label",
      "label": "Texte du lien vidéo",
      "default": "Voir notre univers en vidéo"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Format paysage, 2400 px de large minimum. Laissez de l'espace à gauche pour le texte."
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image mobile",
          "info": "Facultatif. Format portrait."
        },
        {
          "type": "range",
          "id": "scrim",
          "label": "Voile sous le texte",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 55
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Surtitre",
          "default": "Des intérieurs qui ont une âme"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Titre",
          "default": "L’art des maisons de caractère."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte",
          "info": "20 mots maximum.",
          "default": "<p>Des papiers peints d’exception, imaginés pour révéler le charme, l’élégance et la personnalité de chaque intérieur.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Bouton",
          "default": "Découvrir nos collections"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Lien du bouton"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ouverture",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
