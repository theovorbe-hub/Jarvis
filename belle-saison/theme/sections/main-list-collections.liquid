<section class="collections-page page-width">
  <header class="collection__header">
    <h1 class="h-display">{{ section.settings.heading | default: page_title | escape }}</h1>
  </header>
  {%- if collections.size > 0 -%}
    <ul class="collections-page__grid" role="list">
      {%- for c in collections -%}
        {%- if c.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        <li class="collection-card" data-reveal>
          <a class="collection-card__link" href="{{ c.url }}">
            <div class="collection-card__media">
              {%- if c.featured_image -%}
                {{
                  c.featured_image
                  | image_url: width: 1200
                  | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', class: 'collection-card__image'
                }}
              {%- else -%}
                {%- capture placeholder_name -%}collection-{{ forloop.index | modulo: 6 | plus: 1 }}{%- endcapture -%}
                {{ placeholder_name | placeholder_svg_tag: 'collection-card__image placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="collection-card__body">
              <h2 class="collection-card__title">{{ c.title | escape }}</h2>
              {%- if c.description != blank -%}
                <p class="collection-card__text">{{ c.description | strip_html | truncatewords: 14 }}</p>
              {%- endif -%}
              <span class="collection-card__arrow">{% render 'icon', name: 'arrow-right' %}</span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <div class="empty-state">
      <p class="h-3">{{ 'collections.general.no_collections' | t }}</p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Liste des collections",
  "class": "section-main-list-collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Nos collections"
    }
  ]
}
{% endschema %}
