{%- comment -%}
  Questions fréquentes : ce que le client veut savoir avant de commander, chaque réponse
  s'appuyant sur un engagement réel de la boutique. Questions formulées de façon positive
  (« Comment choisir… », jamais « Et si… ») : la section répond sans faire naître de doute.
  Les réponses restent visibles (pas d'accordéon) : elles se lisent sans clic.
{%- endcomment -%}
<section class="section reassurance">
  <div class="page-width reassurance__grid">
    <div class="reassurance__intro" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h-1">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="reassurance__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    <ol class="reassurance__list" role="list">
      {%- for block in section.blocks -%}
        <li class="reassurance__item" {{ block.shopify_attributes }} data-reveal style="--delay: {{ forloop.index0 | modulo: 4 }};">
          {%- if block.settings.icon != 'none' -%}
            <span class="reassurance__icon">{%- render 'icon', name: block.settings.icon -%}</span>
          {%- endif -%}
          <div>
            <h3 class="reassurance__question">{{ block.settings.question | escape }}</h3>
            {%- if block.settings.answer != blank -%}
              <p class="reassurance__answer">{{ block.settings.answer | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Questions fréquentes",
  "class": "section-reassurance",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Questions fréquentes"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Tout pour choisir votre papier peint."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Couleur, mesures, pose, livraison : l’essentiel pour commander votre papier peint et le voir prendre place chez vous.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton",
      "default": "Choisir mon échantillon offert"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "none", "label": "Aucune" },
            { "value": "palette", "label": "Couleurs" },
            { "value": "ruler", "label": "Règle" },
            { "value": "paint", "label": "Rouleau de pose" },
            { "value": "diamond", "label": "Diamant" },
            { "value": "truck", "label": "Livraison" },
            { "value": "leaf", "label": "Feuille" },
            { "value": "gift", "label": "Cadeau" },
            { "value": "house", "label": "Maison" },
            { "value": "shield", "label": "Garantie" },
            { "value": "printer", "label": "Impression" },
            { "value": "frame", "label": "Cadre" }
          ],
          "default": "palette"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "info": "Formulez-la de façon positive (« Comment… », « Quel… »), sans évoquer de risque.",
          "default": "Comment choisir la bonne couleur ?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Réponse",
          "info": "Ne promettre que ce que la boutique propose vraiment.",
          "default": "Commandez votre échantillon A4 offert : vous voyez le vrai papier, dans votre lumière, avant de décider."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions fréquentes",
      "blocks": [
        { "type": "item" },
        { "type": "item", "settings": { "icon": "ruler", "question": "Comment indiquer mes mesures ?", "answer": "Vous saisissez la largeur et la hauteur de votre mur : la surface est calculée pour vous et le papier est imprimé à ces dimensions." } },
        { "type": "item", "settings": { "icon": "truck", "question": "Quel est le délai de livraison ?", "answer": "Votre commande est livrée sous 5 à 7 jours en France et en Europe." } }
      ]
    }
  ]
}
{% endschema %}
