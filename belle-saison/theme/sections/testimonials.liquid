{%- comment -%}
  Avis clients : uniquement des avis réels. La section n'apparaît pas sur la boutique tant
  qu'elle ne contient ni avis, ni bloc d'application, ni bloc « Code personnalisé » qui affiche
  quelque chose (widget Trustpilot ou Judge.me collé tel quel ; un code réservé à l'éditeur,
  entouré de request.design_mode, ne rend pas la section visible aux visiteurs). Dans l'éditeur,
  une section vide montre des cartes d'exemple, signalées comme telles, pour voir la mise en
  page ; elles ne sont jamais affichées aux visiteurs. Le badge « Vérifié » ne s'affiche que
  pour les avis cochés comme liés à un achat confirmé, et la ligne de synthèse ne parle
  d'« avis vérifiés » que si tous les avis le sont. Avec « avis 5 étoiles seulement », la note
  moyenne reste calculée sur tous les avis de la section. Un avis coché « Exemple » (case cochée
  par défaut) ne s'affiche que dans l'éditeur, marqué comme tel, et n'entre jamais dans la note
  moyenne des visiteurs : la marchande peut écrire ses exemples dans les champs pour voir la forme.
{%- endcomment -%}
{%- liquid
  assign count = 0
  assign app_count = 0
  assign shown_count = 0
  assign total = 0
  assign verified_count = 0
  assign sample_count = 0
  assign sample_total = 0
  assign sample_verified = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_count = app_count | plus: 1
      continue
    endif
    if block.type == 'custom_liquid'
      capture widget_output
        echo block.settings.custom_liquid
      endcapture
      assign widget_output = widget_output | strip
      if widget_output != ''
        assign app_count = app_count | plus: 1
      endif
      continue
    endif
    if block.settings.sample
      unless request.design_mode
        continue
      endunless
      assign sample_count = sample_count | plus: 1
      assign sample_total = sample_total | plus: block.settings.rating
      if block.settings.verified
        assign sample_verified = sample_verified | plus: 1
      endif
    else
      assign count = count | plus: 1
      assign total = total | plus: block.settings.rating
      if block.settings.verified
        assign verified_count = verified_count | plus: 1
      endif
    endif
    unless section.settings.only_five_stars and block.settings.rating != 5
      assign shown_count = shown_count | plus: 1
    endunless
  endfor
  if count > 0
    assign average = total | times: 1.0 | divided_by: count
  elsif sample_count > 0
    assign average = sample_total | times: 1.0 | divided_by: sample_count
  endif
  if count > 0 or sample_count > 0
    assign average_rounded = average | times: 10 | round | divided_by: 10.0
    assign average_label = average_rounded | append: '' | remove: '.0' | replace: '.', ','
  endif
  assign preview = false
  if count == 0 and sample_count == 0 and app_count == 0 and request.design_mode
    assign preview = true
    assign shown_count = 3
  endif
-%}
{%- capture star -%}
  <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false"><path d="M234.29,114.85l-45,38.83L203,211.75a16.4,16.4,0,0,1-24.5,17.82L128,198.49,77.47,229.57A16.4,16.4,0,0,1,53,211.75l13.76-58.07-45-38.83A16.46,16.46,0,0,1,31.08,86l59-4.76,22.76-55.08a16.36,16.36,0,0,1,30.27,0l22.75,55.08,59,4.76a16.46,16.46,0,0,1,9.37,28.86Z" fill="currentColor"/></svg>
{%- endcapture -%}
{%- if shown_count > 0 or app_count > 0 -%}
  <section class="section testimonials" data-carousel>
    <div class="page-width">
      <div class="testimonials__head" data-reveal>
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="h-1">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
        {%- if shown_count > 1 -%}
          <div class="testimonials__nav">
            <button type="button" class="icon-button" data-carousel-prev aria-label="{{ 'sections.testimonials.previous' | t }}">
              {%- render 'icon', name: 'arrow-left' -%}
            </button>
            <button type="button" class="icon-button" data-carousel-next aria-label="{{ 'sections.testimonials.next' | t }}">
              {%- render 'icon', name: 'arrow-right' -%}
            </button>
          </div>
        {%- endif -%}
      </div>

      {%- if preview -%}
        <p class="testimonials__preview-note">{{ 'sections.testimonials.preview_note' | t }}</p>
      {%- elsif sample_count > 0 -%}
        <p class="testimonials__preview-note">{{ 'sections.testimonials.sample_note' | t }}</p>
      {%- endif -%}

      {%- if shown_count > 0 -%}
        <ul class="testimonials__track" role="list" tabindex="0" aria-label="{{ section.settings.heading | strip_html | escape }}" data-carousel-track>
          {%- if preview -%}
            {%- for i in (1..3) -%}
              <li class="testimonial testimonial--sample">
                <div class="testimonial__rating">
                  <span class="rating-boxes" role="img" aria-label="{{ 'sections.testimonials.rating' | t: rating: 5 }}">
                    {%- for n in (1..5) -%}<span class="rating-boxes__box is-on">{{ star }}</span>{%- endfor -%}
                  </span>
                  <span class="testimonial__verified">
                    {%- render 'icon', name: 'seal-check' -%}
                    {{ 'sections.testimonials.verified' | t }}
                  </span>
                </div>
                <h3 class="testimonial__title">{{ 'sections.testimonials.sample_title' | t }}</h3>
                <p class="testimonial__text">{{ 'sections.testimonials.sample_text' | t }}</p>
                <footer class="testimonial__footer">
                  <p class="testimonial__signature"><span class="testimonial__author">{{ 'sections.testimonials.sample_author' | t }}</span></p>
                </footer>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- if block.type != 'review' -%}{%- continue -%}{%- endif -%}
              {%- if block.settings.sample -%}{%- unless request.design_mode -%}{%- continue -%}{%- endunless -%}{%- endif -%}
              {%- if section.settings.only_five_stars and block.settings.rating != 5 -%}{%- continue -%}{%- endif -%}
              <li class="testimonial{% if block.settings.sample %} testimonial--sample{% endif %}" {{ block.shopify_attributes }}>
                <div class="testimonial__rating">
                  <span class="rating-boxes" role="img" aria-label="{{ 'sections.testimonials.rating' | t: rating: block.settings.rating }}">
                    {%- for n in (1..5) -%}
                      <span class="rating-boxes__box{% if n <= block.settings.rating %} is-on{% endif %}">{{ star }}</span>
                    {%- endfor -%}
                  </span>
                  {%- if block.settings.verified -%}
                    <span class="testimonial__verified">
                      {%- render 'icon', name: 'seal-check' -%}
                      {{ 'sections.testimonials.verified' | t }}
                    </span>
                  {%- endif -%}
                  {%- if block.settings.sample -%}
                    <span class="testimonial__sample-tag">{{ 'sections.testimonials.sample_tag' | t }}</span>
                  {%- endif -%}
                </div>
                {%- if block.settings.title != blank -%}
                  <h3 class="testimonial__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                <blockquote class="testimonial__text">{{ block.settings.text | escape | newline_to_br }}</blockquote>
                <footer class="testimonial__footer">
                  <p class="testimonial__signature">
                    <span class="testimonial__author">{{ block.settings.author | escape }}</span>
                    {%- if block.settings.location != blank %}, {{ block.settings.location | escape }}{% endif -%}
                    {%- if block.settings.date != blank %}, {{ block.settings.date | escape }}{% endif -%}
                  </p>
                  {%- if block.settings.product != blank -%}
                    <p class="testimonial__product">{{ 'sections.testimonials.product' | t }} {{ block.settings.product | escape }}</p>
                  {%- endif -%}
                </footer>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_summary and count == 0 and sample_count > 0 -%}
        <p class="testimonials__summary">
          {%- if sample_verified == sample_count -%}
            {{- 'sections.testimonials.summary_sample_verified_html' | t: rating: average_label, number: sample_count -}}
          {%- else -%}
            {{- 'sections.testimonials.summary_sample_html' | t: rating: average_label, number: sample_count -}}
          {%- endif -%}
        </p>
      {%- endif -%}
      {%- if section.settings.show_summary and count > 0 -%}
        <p class="testimonials__summary">
          {%- if verified_count < count -%}
            {{ 'sections.testimonials.summary_html' | t: rating: average_label, number: count }}
          {%- elsif count == 1 -%}
            {{ 'sections.testimonials.summary_verified_single_html' | t: rating: average_label, number: count }}
          {%- else -%}
            {{ 'sections.testimonials.summary_verified_html' | t: rating: average_label, number: count }}
          {%- endif -%}
          {%- if section.settings.only_five_stars %} {{ 'sections.testimonials.five_stars_only' | t }}{%- endif -%}
        </p>
      {%- endif -%}

      {%- if app_count > 0 -%}
        <div class="testimonials__apps">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              {% render block %}
            {%- elsif block.type == 'custom_liquid' -%}
              {%- capture widget_output -%}{{ block.settings.custom_liquid }}{%- endcapture -%}
              {%- assign widget_output = widget_output | strip -%}
              {%- if widget_output != '' -%}
                <div class="testimonials__widget" {{ block.shopify_attributes }}>{{ widget_output }}</div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Avis clients",
  "class": "section-testimonials",
  "max_blocks": 24,
  "settings": [
    {
      "type": "paragraph",
      "content": "N’ajoutez que des avis réels de vos clients, jamais d’avis inventés ni copiés sur d’autres sites : c’est une pratique commerciale trompeuse. La section reste invisible sur la boutique tant qu’elle ne contient aucun avis. Dans l’éditeur, une section vide montre des cartes d’exemple que les visiteurs ne voient jamais. Vous pouvez aussi y ajouter le bloc d’une application d’avis (Trustpilot, Judge.me) ou coller son code dans un bloc « Code personnalisé »."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Avis clients"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Ils ont habillé leurs murs."
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Afficher la note moyenne sous les avis",
      "info": "Calculée à partir des avis de la section. Le mot « vérifiés » n’apparaît que si tous les avis sont cochés « Avis vérifié ».",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "only_five_stars",
      "label": "Montrer seulement les avis 5 étoiles",
      "info": "La note moyenne reste calculée sur tous les avis de la section, et la ligne de synthèse le précise.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "custom_liquid",
      "name": "Code personnalisé",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Code du widget d’avis",
          "info": "Collez ici le code fourni par votre service d’avis (TrustBox de Trustpilot, widget Judge.me). Il doit afficher vos vrais avis, jamais des avis écrits à la main dans le code."
        }
      ]
    },
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        {
          "type": "checkbox",
          "id": "sample",
          "label": "Exemple, visible seulement dans l’éditeur",
          "info": "Cochée, l’avis sert à voir la forme : les visiteurs ne le voient jamais. Décochez uniquement pour l’avis réel d’un client, avec son accord.",
          "default": true
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Note",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre de l’avis"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Avis",
          "info": "Le texte exact du client."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Prénom et initiale du client",
          "info": "Avec son accord. Exemple : Claire D."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Ville"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Produit acheté"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "info": "Exemple : octobre 2026."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Avis vérifié",
          "info": "À cocher uniquement si l’avis provient d’un achat confirmé dans la boutique.",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avis clients"
    }
  ]
}
{% endschema %}
