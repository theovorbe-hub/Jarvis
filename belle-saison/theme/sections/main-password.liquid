<section class="password">
  <div class="password__inner">
    <p class="header__logo">
      <span class="header__wordmark">{{ shop.name | escape }}</span>
      {%- if settings.logo_tagline != blank -%}
        <span class="header__tagline">{{ settings.logo_tagline | escape }}</span>
      {%- endif -%}
    </p>
    <h1 class="h-1">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="password__message">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'password__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <div class="field">
        <label class="field__label" for="PasswordNewsletter">{{ 'newsletter.label' | t }}</label>
        <div class="field__row">
          <input class="field__input" id="PasswordNewsletter" type="email" name="contact[email]" autocomplete="email" required>
          <button type="submit" class="button">{{ 'newsletter.button' | t }}</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="field__success" role="status">{{ 'newsletter.success' | t }}</p>
        {%- endif -%}
      </div>
    {%- endform -%}

    <details class="password__access">
      <summary>{{ 'general.password.access' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        <div class="field">
          <label class="field__label" for="StorefrontPassword">{{ 'general.password.label' | t }}</label>
          <div class="field__row">
            <input class="field__input" id="StorefrontPassword" type="password" name="password" autocomplete="current-password" required>
            <button type="submit" class="button">{{ 'general.password.enter' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p class="field__error">{{ 'general.password.error' | t }}</p>
          {%- endif -%}
        </div>
      {%- endform -%}
      <p class="password__admin">{{ 'general.password.admin_link_html' | t }}</p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Page mot de passe",
  "class": "section-main-password",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "La boutique ouvre bientôt."
    }
  ]
}
{% endschema %}
