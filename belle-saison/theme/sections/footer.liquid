<footer class="footer">
  <div class="footer__inner page-width">
    <div class="footer__blocks">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div class="footer__brand" {{ block.shopify_attributes }}>
              <p class="footer__wordmark">{{ shop.name | escape }}</p>
              {%- if block.settings.text != blank -%}
                <div class="footer__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- render 'social-links' -%}
            </div>
          {%- when 'menu' -%}
            {%- assign footer_menu = linklists[block.settings.menu] -%}
            <nav class="footer__menu" {{ block.shopify_attributes }} aria-label="{{ block.settings.heading | escape }}">
              {%- if block.settings.heading != blank -%}
                <p class="footer__heading">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
              <ul role="list">
                {%- for link in footer_menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- when 'text' -%}
            <div class="footer__menu" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="footer__heading">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}
      </p>
      {%- if shop.policies.size > 0 -%}
        <ul class="footer__policies" role="list">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.show_payment_icons -%}
        <ul class="footer__payments" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "class": "section-footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Afficher les moyens de paiement",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marque",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte",
          "default": "<p>Papiers peints d’exception, en rouleaux et en échantillons.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Boutique"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texte",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Showroom"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte",
          "default": "<p>Ajoutez ici une adresse ou des horaires.</p>"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "brand"
      },
      {
        "type": "menu"
      }
    ]
  }
}
{% endschema %}
